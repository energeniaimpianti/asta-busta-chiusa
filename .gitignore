.tools/collaudo-liste-note.txt

# --- script email del canale Aruba (contengono riferimenti alla casella personale) ---
send_*email*.py
*invia*.ps1

# --- Android: build e configurazione macchina ---
AstaChiusa/.gradle/
AstaChiusa/build/
AstaChiusa/app/build/
AstaChiusa/local.properties

